<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
     <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Optimised even in Debug: the emulator runs millions of instructions a second and an unoptimised
         build can't keep up with real time. Remove this to step through instructions in a debugger. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="../SharedDomainTypes/SharedDomainTypes.csproj" />
  </ItemGroup>

</Project>
